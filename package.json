    ".": {
      "types": {
        "import": "./dist/index.d.ts",
        "default": "./dist/index.d.cts"
      },
      "import": "./dist/index.js",
      "default": "./dist/index.cjs"
    }
  },
  "engines": {
    "node": ">=16"
  },
  "packageManager": "pnpm@10.6.5",
  "@jcoreio/toolchain": {
    "migratedVersion": "5.8.2"
  }
